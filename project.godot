; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Critter Catcher"
run/main_scene="res://areas/jade-town.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[autoload]

Pause="*res://pause-manager/prefabs/pause_manager.tscn"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
PlayerManager="*res://player-manager.tscn"
GlobalVariables="*res://globals.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/health_bar_2d/plugin.cfg")

